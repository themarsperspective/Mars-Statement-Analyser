  "conflict_rules": {
    "principle": "One business fact should influence a score once. Where inferred and confirmed evidence both exist for the same underlying fact, apply the confirmed modifier only, never both. Use the most specific, highest-confidence rule available.",
    "conflict_groups": {
      "multi_site": { "prefer": "multi_site_confirmed", "over": "multi_mid_inferred" }
    }
  },
  "high_risk_merchant_services": {
    "hidden_by_default": true,
    "base_score_if_configured_specialist_sector": 80,
    "modifiers": [
      { "condition": "Evidence of previous acquiring rejection or placement difficulty", "adjustment": 10 },
      { "condition": "Evidence of specialist acquiring restrictions, reserve requirements, or unusually burdensome acquiring terms", "adjustment": 5 },
      { "condition": "Existing stable specialist acquiring arrangement with no identified issue", "adjustment": -10 }
    ],
    "max_score": 100,
    "display_threshold": 70,
    "wording_rule": "Never describe the merchant itself as 'high-risk'. Use phrasing such as 'Specialist acquiring may be worth reviewing for this business type.'"
  },
  "score_bands": [
    { "min": 90, "max": 100, "label": "Exceptional", "description": "A priority conversation." },
    { "min": 80, "max": 89, "label": "Very High", "description": "Strong relevance." },
    { "min": 70, "max": 79, "label": "High", "description": "Clearly worth qualifying." },
    { "min": 60, "max": 69, "label": "Moderate", "description": "Worth asking if the conversation permits." },
    { "min": 0, "max": 59, "label": "Low", "description": "Normally do not display, unless a specific explicit signal makes it useful." }
  ]
